# Copy to .env for local runs. Never commit .env or a real key.
MINIMAX_BASE_URL=http://127.0.0.1:7863/v1
MINIMAX_API_KEY=
MINIMAX_MODEL=cn:minimax-m3.1-flash
MINIMAX_TIMEOUT_SECONDS=120

# Local state. Keep both under data/ so `cli reset` removes them together.
MINIMAX_SEAKDB_PATH=data/seekdb
POWERCONTEXT_DB=data/powercontext.db

# Interpreter used to run the business project's tests. Leave empty to reuse
# the interpreter running the CLI.
MINIMAX_TEST_PYTHON=

# Optional: pin the validation task. Leave empty to read it from the single
# OpenSpec change under openspec/changes/.
MINIMAX_CHANGE=
MINIMAX_TASK=
