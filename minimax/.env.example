# ---- SDD 上下文模块配置示例（请复制为 .env 并替换占位值，不要提交真实凭据）----

# 任务状态服务 PowerContext
SDCTX_PC_URL=http://127.0.0.1:18080
SDCTX_PC_SCOPE=replace-with-existing-scope-id
# SDCTX_PC_TOKEN=replace-with-server-token

# MiniMax（OpenAI 兼容接口）
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_MODEL=MiniMax-M3

# seekdb / OceanBase
# embedded：使用本机嵌入式 seekdb（默认，无需额外部署）
SDCTX_SEEKDB_MODE=embedded
SDCTX_SEEKDB_DATABASE=sdctx
# server：连接外部已启动的 seekdb 或 OceanBase（MySQL 协议）
# SDCTX_SEEKDB_MODE=server
# SDCTX_DB_HOST=127.0.0.1
# SDCTX_DB_PORT=2881
# SDCTX_DB_USER=root
# SDCTX_DB_PASSWORD=replace-with-password

# 业务工程与本地数据目录
SDCTX_PROJECT_ROOT=./business_project
SDCTX_HOME=./.sdctx
