# Run python3 scripts/init_env.py to generate unique instance-local secrets.
# This file is documentation; do not use the placeholders as passwords.
SECRET_KEY=<generated>
DB_USERNAME=postgres
DB_DATABASE=dify
DB_PASSWORD=<generated>
POSTGRES_PASSWORD=<same-as-DB_PASSWORD>
REDIS_PASSWORD=<generated>
SANDBOX_API_KEY=<generated>
CODE_EXECUTION_API_KEY=<same-as-SANDBOX_API_KEY>
EXPOSE_NGINX_PORT=127.0.0.1:18081
EXPOSE_NGINX_SSL_PORT=127.0.0.1:18443
BRIDGE_PORT=19080
VECTOR_STORE=weaviate
CERTBOT_EMAIL=
CERTBOT_DOMAIN=
BUREAU_SERVICE_TOKEN=<generated-by-init_env.py>
BUREAU_NAMESPACE=lostfound-v3
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY is supplied to bootstrap_app.py via the terminal environment.
# It is encrypted in Dify's model provider settings; do not put the key in this file or the DSL.
