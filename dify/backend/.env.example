# PowerContext 服务地址。本作品用 `powercontext server run --port 18080` 启动；
# 如果你用 PowerContext 默认端口 8000，这里同步改成 127.0.0.1:8000。
# 注意：这个地址是【记忆桥】访问 PowerContext 用的，两者都在宿主机，所以用 127.0.0.1 正确。
PC_BASE_URL=http://127.0.0.1:18080
# 开启鉴权时填写
# PC_TOKEN=replace-with-token
# 指定已有 Scope；留空则自动查找/创建
# PC_SCOPE_ID=scp_xxxxxxxx
PC_SCOPE_TITLE=记仇小妖 · GrudgeImp
# 桥接服务端口
PORT=19080
